# Google Apps Script web-app endpoint used for the LIVE (GitHub Pages) build.
# Vite reads this automatically during `npm run build`. The URL is public by
# design (it also ends up in the shipped JS bundle), so keeping it here is fine.
# To change the backend, update this URL and push — Pages redeploys on push.
VITE_QP_ENDPOINT=https://script.google.com/macros/s/AKfycbyh2kIycorzszCMDFqMn_KddljLsRYCjbPLZCpJUplcg6B2BIqLm1N31k2yLHWVlzIt/exec
